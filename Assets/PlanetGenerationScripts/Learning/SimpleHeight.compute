// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

StructuredBuffer<float3> vertices;
// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWStructuredBuffer<float> heights;

uint numVertices;
float heightMultiplier;
float noiseScale;        
int numLayers;           
float persistence;       
float lacunarity;

float hash(float3 p)
{
    // Better hash that avoids directional bias
    float3 scale = float3(0.3183099, 0.3678794, 0.2834218);
    p = frac(p * scale + 0.1);
    p *= 17.0;
    float n = dot(p, float3(p.y, p.z, p.x));
    return frac(n * (n + p.y) * (n + p.z + p.x));
}

float noise3D(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    
    // Smooth interpolation
    f = f * f * (3.0 - 2.0 * f);
    
    // Better 3D hash distribution
    float n = dot(i, float3(1.0, 57.0, 113.0));
    
    return lerp(
        lerp(lerp(hash(n + 0.0), hash(n + 1.0), f.x),
             lerp(hash(n + 57.0), hash(n + 58.0), f.x), f.y),
        lerp(lerp(hash(n + 113.0), hash(n + 114.0), f.x),
             lerp(hash(n + 170.0), hash(n + 171.0), f.x), f.y),
        f.z);
}

float fractalNoise(float3 pos, float scale, int layers)
{
    float value = 0;
    float amplitude = 1;
    float frequency = scale;
    
    for (int i = 0; i < layers; i++)
    {
        value += noise3D(pos * frequency) * amplitude;
        
        frequency *= lacunarity;  // Use parameter instead of hardcoded 2.0
        amplitude *= persistence; // Use parameter instead of hardcoded 0.5
    }
    return value;
}

float ridgeNoise(float3 pos, float scale, int layers)
{
    float value = 0.0;
    float amplitude = 1.0;
    float frequency = scale;
    float ridgePower = 2.0;
    
    for (int i = 0; i < layers; i++)
    {
        float noiseValue = noise3D(pos * frequency);
        float ridge = 1.0 - abs(noiseValue);
        ridge = pow(ridge, ridgePower);
        
        value += ridge * amplitude;
        
        frequency *= lacunarity;  // Use parameter
        amplitude *= persistence; // Use parameter
    }
    
    return value;
}

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numVertices)
    {
        return;
    }

    float3 pos = vertices[id.x];
    
    float continentNoise = fractalNoise(pos, noiseScale, numLayers);
    float mountainNoise = ridgeNoise(pos, noiseScale * 2.0, numLayers + 1);
    
    // Normalize continentNoise to 0-1 range (fractal noise can exceed 1)
    continentNoise = saturate(continentNoise);
    
    float mask = smoothstep(0.3, 0.7, continentNoise);
    
    // Use heightMultiplier and normalize the final height
    float baseHeight = 1.0;
    float continentHeight = (continentNoise - 0.5) * heightMultiplier;
    float mountainHeight = (mountainNoise - 0.5) * heightMultiplier * 0.5 * mask;
    
    float finalHeight = baseHeight + continentHeight + mountainHeight;
    
    // Clamp to reasonable range
    finalHeight = max(0.5, min(2.0, finalHeight));
    
    heights[id.x] = finalHeight;
}


